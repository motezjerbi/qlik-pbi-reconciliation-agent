# .streamlit/secrets.toml
#
# Copie ce fichier en .streamlit/secrets.toml (sans ".example") et
# remplis les valeurs. Ne commite JAMAIS le vrai secrets.toml (ajoute-le
# à .gitignore) — client_secret et cookie_secret sont sensibles.
#
# ------------------------------------------------------------------
# ÉTAPES DANS GOOGLE CLOUD CONSOLE (console.cloud.google.com)
# ------------------------------------------------------------------
# 1. Crée un projet (ou réutilise un projet existant).
# 2. "APIs & Services" → "Library" → active l'API "Gmail API".
# 3. "APIs & Services" → "OAuth consent screen" :
#      - Type : External (ou Internal si compte Google Workspace)
#      - Renseigne le nom de l'app, email de support
#      - Scopes : ajoute .../auth/gmail.send
#      - Test users : ajoute la/les adresse(s) Gmail que tu utiliseras
#        pour tester (obligatoire tant que l'app est en statut "Testing" —
#        largement suffisant pour un projet de stage/démo, pas besoin de
#        faire vérifier l'app par Google).
# 4. "APIs & Services" → "Credentials" → "Create credentials" →
#    "OAuth client ID" → type "Web application" :
#      - Authorized redirect URIs : http://localhost:8501/oauth2callback
#        (adapte le port/domaine si tu déploies ailleurs)
#      - Récupère le "Client ID" et le "Client secret" générés.
#
# ------------------------------------------------------------------
# INSTALLATION
# ------------------------------------------------------------------
# pip install "streamlit[auth]" requests
#
# ------------------------------------------------------------------

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "REMPLACE_PAR_UNE_CHAINE_ALEATOIRE_LONGUE"
client_id = "REMPLACE_PAR_TON_CLIENT_ID.apps.googleusercontent.com"
client_secret = "REMPLACE_PAR_TON_CLIENT_SECRET"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"

# Expose le jeton d'accès (pas seulement le jeton d'identité) pour pouvoir
# appeler l'API Gmail au nom de l'utilisateur connecté.
expose_tokens = "access"

# Demande, en plus des scopes d'identité par défaut (openid profile email),
# le scope gmail.send pour pouvoir envoyer des emails via l'API Gmail.
# IMPORTANT : client_kwargs doit rester une table EN LIGNE ici, à l'intérieur
# de [auth] — ne pas la sortir en section [auth.client_kwargs], sinon
# Streamlit l'interprète comme un fournisseur nommé "client_kwargs".
client_kwargs = { scope = "openid email profile https://www.googleapis.com/auth/gmail.send", prompt = "consent select_account" }

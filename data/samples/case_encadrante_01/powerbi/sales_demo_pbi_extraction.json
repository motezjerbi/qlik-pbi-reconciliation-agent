    },
    {
      "name": "Sales Excluding North Region",
      "value": 2900.0,
      "expression": "CALCULATE([Total Sales], 'Sales'[Region] <> \"North\", 'Sales'[Year] = MAX('Sales'[Year]))"
    },
    {

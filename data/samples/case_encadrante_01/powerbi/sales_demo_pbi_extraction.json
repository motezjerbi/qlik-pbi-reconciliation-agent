      "name": "Latest Month Sales",
      "value": 2100.0,
      "expression": "VAR _LatestDate = CALCULATE(MAX(Sales[Order Date]), REMOVEFILTERS(Sales))\nVAR _LatestYear = YEAR(_LatestDate)\nVAR _LatestMonth = MONTH(_LatestDate)\nRETURN\n    CALCULATE(\n        [Total Sales],\n        KEEPFILTERS(Sales[Year] = _LatestYear),\n        KEEPFILTERS(Sales[Month] = _LatestMonth)\n    )"
    },
    {
      "name": "Year To Date Sales",
      "value": 4100.0,
      "expression": "TOTALYTD([Total Sales], 'Sales'[Order Date])"
    },
